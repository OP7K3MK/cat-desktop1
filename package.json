{
  "name": "desktop-cat",
  "version": "1.0.0",
  "description": "3D desktop cat with local AI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --publish never"
  },
  "dependencies": {
    "three": "0.160.0",
    "node-llama-cpp": "^3.6.0",
    "@huggingface/transformers": "^3.3.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "local.desktop.cat",
    "productName": "DesktopCat",
    "asar": false,
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "package.json",
      "node_modules/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v3/{linux,darwin}/**",
      "!node_modules/**/*.{md,map,ts}"
    ],
    "forceCodeSigning": false,
    "npmRebuild": false
  }
}